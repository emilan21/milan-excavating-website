{
  "name": "milan-excavating-website",
  "version": "1.0.0",
  "description": "Milan's Excavating & Landscaping static website",
  "scripts": {
    "test:e2e": "cypress run --config-file test/cypress.config.js",
    "dev": "bash dev.sh",
    "dev:pages": "WRANGLER_LOG_PATH=/tmp/milan-pages-wrangler.log wrangler pages dev frontend --port=8000 --inspector-port=9330 --compatibility-date=2026-08-22",
    "deploy": "bash deploy.sh",
    "deploy:pages": "WRANGLER_LOG_PATH=/tmp/milan-pages-wrangler.log wrangler pages deploy frontend --project-name milan-excavating-site"
  },
  "devDependencies": {
    "cypress": "^13.17.0",
    "wrangler": "latest"
  },
  "keywords": [
    "excavating",
    "landscaping",
    "cloudflare",
    "pages"
  ],
  "author": "Eric Milan",
  "license": "MIT"
}
