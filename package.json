{
  "name": "milan-excavating-website",
  "version": "1.0.0",
  "description": "Milan's Excavating & Landscaping website with local dev server",
  "scripts": {
    "build": "npm run build:module && npm run generate && npm run build:client",
    "build:module": "spacetime build --module-path spacetimedb",
    "build:client": "node scripts/build-client.mjs",
    "generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb --include-private --yes",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p spacetimedb/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "cypress run --config-file test/cypress.config.js",
    "dev": "bash dev.sh",
    "dev:pages": "wrangler pages dev frontend --port=8000 --inspector-port=9230 --compatibility-date=2026-08-22",
    "dev:worker": "wrangler dev --config worker/wrangler.jsonc --port=8787 --inspector-port=9231",
    "dev:db": "spacetime dev milan-excavating-local --project-path . --server local --server-only --yes",
    "deploy": "bash deploy.sh",
    "deploy:module": "spacetime publish milan-excavating --server maincloud --module-path spacetimedb --delete-data=never --yes=remote,migrate",
    "deploy:worker": "wrangler deploy --config worker/wrangler.jsonc",
    "deploy:pages": "wrangler pages deploy frontend --project-name milan-excavating-site",
    "cf-types": "WRANGLER_LOG_PATH=/tmp/milan-wrangler.log wrangler types --config worker/wrangler.jsonc --include-runtime=false --strict-vars=false worker/worker-configuration.d.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "@cloudflare/workers-types": "latest",
    "cypress": "^13.17.0",
    "esbuild": "latest",
    "typescript": "~5.6.2",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "oidc-client-ts": "latest",
    "spacetimedb": "2.10.*"
  },
  "keywords": [
    "excavating",
    "landscaping",
    "cloudflare",
    "pages"
  ],
  "author": "Eric Milan",
  "license": "MIT"
}
